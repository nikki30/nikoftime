<title>Do Not Fret</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: a practice journal. One narrow column of paper, staff-ruled section heads,
   a rosewood fretboard as the centrepiece, metronome docked above the tab bar. */
:root {
  --paper: #f3f1e4;
  --paper-2: #e7ebd6;
  --paper-3: #d6e0bd;
  --ink: #1b2819;
  --ink-soft: #55644c;
  --rose: #2e5e33;
  --brass: #d8961f;
  --brass-ink: #241a05;
  --line: #c9d3b0;
  --good: #4f8a32;
  --olive: #6f7d1c;
  --hero-1: #23472a;
  --hero-2: #5f7019;
  --hero-ink: #f7f3df;
  --hero-soft: #cfdcae;
  --wood: #3b1f16;
  --wood-2: #4a2a1e;
  --fret: #c9b693;
  --string: #e7dcc6;
  --pearl: #f6efe2;
  --pearl-ink: #2a1a14;
  --dock: #1d3a22;
  --shadow: 0 1px 0 rgba(30, 50, 20, .06), 0 12px 30px -18px rgba(30, 60, 20, .5);
  --display: "Cormorant Garamond", "Iowan Old Style", Georgia, serif;
  --ui: "Work Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #111811; --paper-2: #192319; --paper-3: #233223;
    --ink: #edf1dc; --ink-soft: #a7b598; --rose: #a3cf86; --brass: #ebb34c; --brass-ink: #1d1404;
    --line: #2f3f2c; --good: #8fcf6b; --olive: #c2cf5e;
    --hero-1: #1c3a21; --hero-2: #3f5114; --hero-ink: #f3efd8; --hero-soft: #bccb98;
    --wood: #26140e; --wood-2: #301a12; --fret: #a8916c;
    --string: #d8ccb5; --pearl: #efe5d2; --pearl-ink: #24130d; --dock: #0c160d;
    --shadow: 0 0 0 1px rgba(220, 255, 200, .05); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #111811; --paper-2: #192319; --paper-3: #233223;
  --ink: #edf1dc; --ink-soft: #a7b598; --rose: #a3cf86; --brass: #ebb34c; --brass-ink: #1d1404;
  --line: #2f3f2c; --good: #8fcf6b; --olive: #c2cf5e;
  --hero-1: #1c3a21; --hero-2: #3f5114; --hero-ink: #f3efd8; --hero-soft: #bccb98;
  --wood: #26140e; --wood-2: #301a12; --fret: #a8916c;
  --string: #d8ccb5; --pearl: #efe5d2; --pearl-ink: #24130d; --dock: #0c160d;
  --shadow: 0 0 0 1px rgba(220, 255, 200, .05); color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--paper); color: var(--ink);
  font: 15px/1.6 var(--ui); -webkit-font-smoothing: antialiased;
  padding-inline: 16px; padding-block: 0 190px;
}
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; border-radius: 4px; }
.wrap { max-width: 720px; margin: 0 auto; }

/* ---------- header + tabs ---------- */
.top { display: flex; align-items: baseline; justify-content: space-between; padding-block: 22px 6px; gap: 12px; }
#status { font-size: .75rem; text-align: right; max-width: 55%; }
.brand { font: italic 600 1.35rem/1 var(--display); color: var(--rose); letter-spacing: .01em; }
.brand b { font-style: normal; }
.tabs {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  display: flex; justify-content: center; gap: 2px;
  background: var(--paper-2); border-top: 1px solid var(--line);
  padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
}
.tabs button {
  flex: 1; max-width: 130px; background: none; border: 0; cursor: pointer;
  padding: 8px 4px; border-radius: 10px; font-size: .78rem; font-weight: 500; color: var(--ink-soft);
  display: flex; flex-direction: column; align-items: center; gap: 2px;
}
.tabs button .g { font: 600 1.15rem/1 var(--display); }
.tabs button[aria-current="page"] { color: var(--rose); background: var(--paper-3); }

/* ---------- type ---------- */
h1, h2, h3 { font-family: var(--display); font-weight: 600; text-wrap: balance; margin: 0; color: var(--ink); }
h1 { font-size: clamp(2.1rem, 7vw, 2.9rem); line-height: 1.02; letter-spacing: -.01em; }
h2 { font-size: 1.6rem; line-height: 1.1; }
h3 { font-size: 1.25rem; line-height: 1.15; }
.eyebrow { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--brass); font-weight: 600; }
.soft { color: var(--ink-soft); }
.small { font-size: .85rem; }
.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
p { margin: 0; }

/* staff-ruled section head: five hairlines under the title */
.staff { display: grid; gap: 8px; padding-block: 34px 14px; }
.staff::after {
  content: ""; height: 13px;
  background: repeating-linear-gradient(to bottom, var(--line) 0 1px, transparent 1px 3px);
  opacity: .9;
}
.staff .row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

/* ---------- surfaces ---------- */
.sheet { background: var(--paper-2); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); }
.list { display: grid; gap: 0; }
.item { border-top: 1px solid var(--line); }
.item:first-child { border-top: 0; }
.item-head {
  width: 100%; display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center;
  padding: 14px 16px; background: none; border: 0; text-align: left; cursor: pointer;
}
.item-head .t { font-weight: 600; min-width: 0; }
.item-head .meta { font-size: .8rem; color: var(--ink-soft); }
.item-body { padding: 0 16px 16px; display: grid; gap: 12px; }
.check {
  width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--ink-soft);
  display: grid; place-items: center; font-size: .75rem; color: transparent;
}
.check.on { background: var(--good); border-color: var(--good); color: var(--paper); }
.pill {
  display: inline-flex; align-items: center; gap: 6px; font-size: .74rem; font-weight: 500;
  padding: 2px 9px; border-radius: 999px; background: var(--paper-3); color: var(--ink-soft); white-space: nowrap;
}
.pill.brass { background: var(--brass); color: var(--brass-ink); }
.pill.rose { background: transparent; border: 1px solid var(--rose); color: var(--rose); }
.btn {
  display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
  border: 1px solid var(--line); background: var(--paper); color: var(--ink);
  padding: 8px 14px; border-radius: 999px; font-weight: 500; font-size: .88rem;
}
.btn:hover { border-color: var(--brass); }
.btn.primary { background: var(--rose); border-color: var(--rose); color: var(--paper); }
.btn:disabled { opacity: .45; cursor: default; }
.btns { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.link { background: none; border: 0; padding: 0; color: var(--rose); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-weight: 500; }
textarea, select, input[type="text"] {
  font: inherit; color: var(--ink); background: var(--paper); border: 1px solid var(--line);
  border-radius: 10px; padding: 10px 12px; width: 100%;
}
textarea { min-height: 84px; resize: vertical; }
select { width: auto; padding: 7px 10px; }
.empty { padding: 22px 18px; color: var(--ink-soft); display: grid; gap: 6px; }
.empty b { color: var(--ink); font-weight: 600; }
.notice { font-size: .85rem; color: var(--ink-soft); border-left: 2px solid var(--brass); padding: 2px 0 2px 12px; }

/* ---------- today ---------- */
.hero { display: grid; gap: 10px; padding-block: 18px 4px; }
.stats { display: flex; gap: 22px; flex-wrap: wrap; padding-top: 6px; }
.stat b { font: 600 1.6rem/1 var(--display); color: var(--rose); display: block; }
.stat span { font-size: .78rem; color: var(--ink-soft); }
.week { display: flex; gap: 6px; }
.week i { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; font: normal 500 .68rem/1 var(--ui); color: var(--ink-soft); }
.week i.on { background: var(--brass); border-color: var(--brass); color: var(--brass-ink); }
.week i.today { border-color: var(--rose); border-width: 1.5px; }
.runs { display: inline-flex; gap: 5px; }
.runs i { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--rose); }
.runs i.on { background: var(--rose); }
.howto { color: var(--ink-soft); font-size: .92rem; }
.spark { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; padding: 12px 16px; border-top: 1px solid var(--line); }
.spark:first-child { border-top: 0; }
.spark svg { grid-column: 1 / -1; width: 100%; height: 44px; }
.spark .s-area { fill: var(--brass); opacity: .14; }
.spark .s-line { fill: none; stroke: var(--brass); stroke-width: 2; }
.spark .s-dot { fill: var(--rose); }
.spark .s-grid { stroke: var(--line); stroke-width: 1; }

/* ---------- theory ---------- */
.builder { padding: 16px; display: grid; gap: 14px; }
.controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
.seg button { border: 0; background: none; padding: 6px 12px; font-size: .82rem; cursor: pointer; color: var(--ink-soft); }
.seg button[aria-pressed="true"] { background: var(--rose); color: var(--paper); }
.steps { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 0; font-family: var(--display); }
.steps .n { font-size: 1.55rem; font-weight: 600; min-width: 2.1ch; text-align: center; color: var(--ink); }
.steps .n.root { color: var(--rose); }
.steps .w { font: 600 .66rem/1 var(--ui); color: var(--brass); letter-spacing: .06em; padding: 0 6px; position: relative; top: -2px; }
.steps .w.h { color: var(--rose); }
.facts { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: .88rem; color: var(--ink-soft); }
.facts b { color: var(--ink); font-weight: 600; }
.fb-scroll { overflow-x: auto; border-radius: 10px; -webkit-overflow-scrolling: touch; }
.fb { display: block; min-width: 760px; width: 100%; height: auto; }
.fb .board { fill: var(--wood); }
.fb .board-2 { fill: var(--wood-2); }
.fb .nut { fill: var(--pearl); }
.fb .fretl { stroke: var(--fret); stroke-width: 2; }
.fb .str { stroke: var(--string); }
.fb .inlay { fill: var(--pearl); opacity: .5; }
.fb .num { fill: var(--ink-soft); font: 500 10px var(--ui); text-anchor: middle; }
.fb .sname { fill: var(--ink-soft); font: 500 11px var(--ui); text-anchor: middle; }
.fb .note { cursor: pointer; }
.fb .note circle { fill: var(--pearl); stroke: var(--wood); stroke-width: 1.5; }
.fb .note text { fill: var(--pearl-ink); font: 600 10px var(--ui); text-anchor: middle; dominant-baseline: central; pointer-events: none; }
.fb .note.root circle { fill: var(--brass); }
.fb .note.root text { fill: var(--brass-ink); }
.fb .note:hover circle { stroke: var(--brass); stroke-width: 2.5; }
.topic { padding: 16px; display: grid; gap: 14px; }
.topic h4 { margin: 0; font: 600 1.1rem/1.2 var(--display); color: var(--rose); }
.topic .sec { display: grid; gap: 6px; max-width: 64ch; }
.topic .sec p { white-space: pre-line; }
.review { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; padding: 16px; }
.review b { font: 600 2rem/1 var(--display); color: var(--rose); }

/* ---------- songs, classes ---------- */
.chart { font: 400 .9rem/1.7 var(--mono); background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; overflow-x: auto; white-space: pre; margin: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font: 500 .85rem/1 var(--mono); padding: 6px 10px; border-radius: 8px; background: var(--paper); border: 1px solid var(--line); }
.timeline { display: grid; gap: 14px; }
.cls { padding: 16px; display: grid; gap: 12px; }
.cls-date { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.cls ul { margin: 0; padding-left: 1.1em; display: grid; gap: 4px; }
.hw { display: grid; gap: 6px; }
.hw label { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
.hw input { margin-top: 4px; accent-color: var(--good); }
.hw .done { text-decoration: line-through; color: var(--ink-soft); }
.next-class { padding: 16px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; }
.next-class b { font: 600 1.9rem/1 var(--display); color: var(--rose); }

/* ---------- notebook pages ---------- */
.uploader { padding: 16px; display: grid; gap: 12px; }
.uploader input[type="file"] { position: absolute; width: 1px; height: 1px; opacity: 0; }
.pages { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 10px; }
.page { display: grid; gap: 4px; min-width: 0; }
.page a { display: block; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); background: var(--paper); aspect-ratio: 3 / 4; }
.page img { width: 100%; height: 100%; object-fit: cover; display: block; }
.page .pdf { width: 100%; height: 100%; display: grid; place-items: center; font: 600 1.1rem var(--display); color: var(--rose); }
.page .cap { font-size: .7rem; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.up-status { font-size: .85rem; color: var(--ink-soft); }
.up-status.err { color: var(--brass); }

/* ---------- metronome dock ---------- */
.dock {
  position: fixed; left: 50%; transform: translateX(-50%); z-index: 19;
  bottom: calc(66px + env(safe-area-inset-bottom, 0px));
  width: min(720px, calc(100% - 20px));
  display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px;
  background: var(--wood); color: var(--pearl); border-radius: 16px; padding: 8px 10px;
  box-shadow: 0 12px 30px -12px rgba(30, 10, 5, .55);
}
.dock .play { width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--brass); color: var(--brass-ink); font-size: 1rem; cursor: pointer; }
.dock .mid { display: grid; gap: 2px; min-width: 0; }
.dock .tempo { display: flex; align-items: center; gap: 6px; }
.dock .tempo button { width: 30px; height: 30px; border-radius: 8px; border: 1px solid rgba(246, 239, 226, .25); background: transparent; color: var(--pearl); cursor: pointer; font-size: 1rem; }
.dock .bpm { font: 600 1.5rem/1 var(--display); min-width: 4.4ch; text-align: center; font-variant-numeric: tabular-nums; }
.dock .bpm small { font: 500 .62rem/1 var(--ui); opacity: .7; letter-spacing: .04em; }
.dock .ctx { font-size: .72rem; opacity: .7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dock .beats { display: flex; gap: 5px; }
.dock .beats i { width: 8px; height: 8px; border-radius: 50%; background: rgba(246, 239, 226, .22); }
.dock .beats i.on { background: var(--brass); }
.dock .side { display: flex; gap: 6px; }
.dock .side button { border: 1px solid rgba(246, 239, 226, .25); background: transparent; color: var(--pearl); border-radius: 8px; padding: 6px 9px; font-size: .78rem; cursor: pointer; }

/* ---------- quiz overlay, toast ---------- */
.overlay { position: fixed; inset: 0; z-index: 40; background: rgba(20, 10, 6, .45); display: grid; place-items: center; padding: 16px; }
.card-q { width: min(520px, 100%); background: var(--paper); border-radius: 18px; padding: 24px; display: grid; gap: 18px; box-shadow: var(--shadow); }
.card-q .q { font: 600 1.6rem/1.2 var(--display); }
.card-q .a { font: 500 1.35rem/1.3 var(--display); color: var(--rose); border-top: 1px solid var(--line); padding-top: 14px; }
.toast {
  position: fixed; left: 50%; transform: translateX(-50%); z-index: 50;
  bottom: calc(140px + env(safe-area-inset-bottom, 0px));
  background: var(--ink); color: var(--paper); padding: 9px 16px; border-radius: 999px; font-size: .85rem;
}


/* ---------- colour: hero bands, categories ---------- */
.hero {
  background: radial-gradient(120% 140% at 100% 0%, var(--hero-2) 0%, transparent 60%), var(--hero-1);
  color: var(--hero-ink); border-radius: 22px; padding: 24px 22px 22px; margin-top: 6px;
  position: relative; overflow: hidden;
}
.hero::after {
  content: ""; position: absolute; right: -40px; top: 18px; width: 240px; height: 74px; opacity: .22;
  background: repeating-linear-gradient(to bottom, var(--hero-soft) 0 1px, transparent 1px 15px);
  transform: rotate(-8deg); pointer-events: none;
}
.hero h1 { color: var(--hero-ink); }
.hero .eyebrow { color: var(--brass); }
.hero .soft, .hero .stat span { color: var(--hero-soft); }
.hero .stat b { color: var(--hero-ink); }
.hero .stat b .soft { color: var(--hero-soft); }
.hero .week i { border-color: rgba(247, 243, 223, .3); color: var(--hero-soft); }
.hero .week i.on { background: var(--brass); border-color: var(--brass); color: var(--brass-ink); }
.hero .week i.today { border-color: var(--hero-ink); }
.tabs button[aria-current="page"] { background: var(--rose); color: var(--paper); }
.staff h2 { color: var(--rose); }
.staff::after { background: repeating-linear-gradient(to bottom, var(--paper-3) 0 1.5px, transparent 1.5px 3px); }
.sheet { border-color: var(--line); }
.pill { background: var(--paper-3); color: var(--ink); }
.pill.cat-warmup { background: var(--brass); color: var(--brass-ink); }
.pill.cat-scale { background: var(--rose); color: var(--paper); }
.pill.cat-skill { background: var(--olive); color: var(--paper); }
.pill.cat-song { background: var(--ink); color: var(--paper); }
.item-head:hover { background: color-mix(in srgb, var(--paper-3) 45%, transparent); }
.dock { background: var(--dock); }
.dock .play { background: var(--brass); }
.review b, .next-class b { color: var(--olive); }
.steps .w { color: var(--olive); }
.steps .w.h { color: var(--brass); }
.btn.primary { background: var(--rose); border-color: var(--rose); color: var(--paper); }

@media (min-width: 900px) {
  body { padding-block: 0 120px; }
  .tabs { position: sticky; top: env(safe-area-inset-top, 0px); bottom: auto; border-top: 0; border-bottom: 1px solid var(--line); background: var(--paper); margin-inline: -16px; }
  .tabs button { flex-direction: row; font-size: .88rem; gap: 8px; }
  .dock { bottom: calc(16px + env(safe-area-inset-bottom, 0px)); }
  .toast { bottom: 100px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
